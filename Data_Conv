//'number' + 3 + 3 - перетворення в рядок, конкатенація
console.log('number' + 3 + 3);

//null + 3 - перетворення в number, null->0, 0+3 = 3
console.log(null + 3);

//5 && "qwerty" - операнд && повертає перший false, але 5 не дорівнює нуль, а отже не false, тоді операнд поверне праву частину виразу
// результат 'qwerty'
console.log(5 && "qwerty");

//+'40' + +'2' + "hillel" - перше рядкове значення перетвориться в з рядку в число (40), далі за таким самим принципом отримаємо число 2
//і між нимии алгебраїчне додавання зробить з них 42, наступна дія конкатенації робить нам рядок '42hillel'
console.log(+'40' + +'2' + "hillel");
  
//'10' - 5 === 6 - рядок '10' перетворить на число  10, мінус 5 не дорівнює 6 (5 не дорівнює 6), то ж буде результат false
console.log ('10' - 5 === 6);

//true + false - перетворення на number, 1 + 0 = 1
console.log(true+false);

//'4px' - 3 - від рядка '4px' відняти три, буде Nan при спробі переведення в число, отримуємо не число
console.log('4px' - 3);
  
//'4' - 3 - перетворення на число 4-3=1
console.log('4' - 3);

//'6' + 3 ** 0 - першої буде дія піднесення до степеня: 3 в степені нуль дорівнює 1, далі конкатенація і результат рядок '61'
console.log('6' + 3 ** 0);

//12 / '6' - операнд ділення переведе рядок '6' в число 6, 12/6 = 2
console.log(12 / '6');

//'10' + (5 === 6) - 5 не дорівнює 6, то ж в дужках маємо false, стрінга плюс false задіє механізм конкатенації, результат 
//'10false'
console.log('10' + (5 === 6));

//null == ''  - null це порожньо, пуста множина, а '' - це рядок довжини 0, тобто це щось, не пуста множина, тому результат false
console.log(null == '');
  
//3 ** (9 / 3) - порядок виконання дій: 1) ділення, бо воно в дужках, результат 3, 2) піднесення до степеня - 27
console.log(3 ** (9 / 3));

//!!'false' == !!'true' - подвійний знак оклику приводить значення до булевого типу, не порожній рядок -> true, отже обидва рядка
// перетворяться в true, результат true
console.log(!!'false' == !!'true');

//0 || '0' && 1 - права частина '0' не порожній рядок, а отже true (неявне приведення), в такому випадку операнд && поверне праву частину виразу - 1
// вийшло 0 || 1. Тут вже ліва частина еквівалентна false, але операнд ||, то ж повернемо 1
console.log(0 || '0' && 1);
  
//(+null == false) < 1 - + перетворить null на число 0, false має еквівалент нуль, == дозволяє порівнювати різні типи, отже маємо 
// аналог 0 = 0, тобто true. В свою чергу воно є аналогом 1, 1<1 - це false
console.log((+null == false) < 1);

//false && true || true - перший операнд поверне перший false (ліву частину виразу), другий операнд поверне true
console.log(false && true || true);

//false && (false || true) - першим в даному випадку буде операнд в дужках, то ж буде true, тепер маємо false && true.
//цей операнд поверне перший false - результат false
console.log(false && (false || true));

//(+null == false) < 1 ** 5 - + перетворює null на число 0, яке в свою чергу при порівнняні неявно перейде в false,
// а само порівняння дасть тоді результат true. Справа підносимо 1 в п'яту степінь, отримаємо 1. true < 1, тут true неявно перетворюється
// на 1 і виходіть 1 < 1, результат false
console.log((+null == false) < 1 ** 5);
