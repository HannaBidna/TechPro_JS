    for (let i = 0; i < count; i++){
        const randomNumber = getRandomNum(10,100);
        if (randomNumber % 2 === 0){
            countOfEven++;
            //console.log(getRandomNum(10,100));
        }
    }
    let countOfOdd = Math.abs(count - countOfEven);
