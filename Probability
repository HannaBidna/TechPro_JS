function getRandomNum (min, max) {
 return Math.floor(Math.random() * (max - min + 1)) + min;
}
function checkProbabilityTheory(count){
    let countOfEven = 0;
    for (let i = 0; i < count; i++){
        const randomNumber = getRandomNum(10,100);
        if (randomNumber % 2 === 0){
            countOfEven++;  
    }
}
const countOfOdd = count - countOfEven;
const percentage = Math.round((countOfEven / count) * 100);

return {
        even: countOfEven,
        odd: countOfOdd,
        percentage: percentage + '%'
    };
}
//console.log('Even numbers:',countOfEven);
//console.log('Odd numbers:',Math.abs(count - countOfEven));
console.log('Even numbers:',checkProbabilityTheory(1000).even);
console.log('Odd numbers:', checkProbabilityTheory(1000).odd);
console.log('Percentage:',checkProbabilityTheory(1000).percentage);
