//Написати функцію pow(x,y) яка буде приймати 2 цисла, перше це число яке ми будемо зводити у ступінь, друге у яку ступінь.

function abs(x) {
  return x < 0 ? -x : x;
}
function pow( x, y){
if (y === 0){
return 1;
}
let result = 1;
for (let i = 0; i < abs(y); i++){
    result = result*x;
    }
if (y < 0) {
return 1/result;
}
return result;
}
  
console.log(pow(2, 6));// 64
console.log(pow(2, -2));// 1/4
console.log(pow(2, 0));// 1
